# DEEPSEEK_API_KEY: Optional API key for DeepSeek code generation (https://platform.deepseek.com)
# When provided, SITECRAFT uses DeepSeek-V3 / DeepSeek-Coder on the backend to compile visual layouts into code.
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"

# GEMINI_API_KEY: Injected automatically at runtime by AI Studio Secrets if configured.
# Used as secondary AI compiler when DEEPSEEK_API_KEY is not set.
GEMINI_API_KEY=""

# APP_URL: Public URL where SITECRAFT is hosted.
APP_URL="http://localhost:3000"
